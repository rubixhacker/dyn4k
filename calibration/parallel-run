#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
if [[ $# != 1 ]]; then echo 'Usage: calibration/parallel-run NEW_OUTPUT_DIRECTORY' >&2; exit 2; fi
out=$1
mkdir "$out"
for s in 0.01 1.0 100.0; do
  for o in '0.0,0.0' '1000.0,1000.0' '-1000.0,1000.0' '1000000.0,-1000000.0' '-1000000.0,1000000.0'; do
    printf '%s\n' "-s$s-o$o-"
  done
done > "$out/partitions.txt"
printf '%s\n' 'P-J-' 'P-JCP-' 'P-JINT-' 'U-' 'G-' >> "$out/partitions.txt"
export root out
xargs -d '\n' -P 4 -I '{}' bash -c '
  part=$1
  destination="$out/$part"
  java -Xmx768m -cp "$root/classes:$root/cache/*:$root/cache/upstream/src/test/resources" Main "$destination" "$part" > "$out/$part.log" 2>&1
' _ '{}' < "$out/partitions.txt"
"$root/scripts/combine.sh" "$out" "$out/partitions.txt"
find "$root/src" "$root/scripts" -type f -print0 | sort -z | xargs -0 sha256sum > "$out/harness.sha256"
java -version 2> "$out/environment.txt"
uname -a >> "$out/environment.txt"
sha256sum "$root"/cache/*.jar >> "$out/environment.txt"
printf '%q ' "$0" "$@" > "$out/command.txt"
printf '\n' >> "$out/command.txt"
