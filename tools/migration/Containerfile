FROM docker.io/library/debian:12-slim@sha256:a4672c0cb26fbdde88e38fa2dfb6c681942306680e41e4378b28770b6e79ee91
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    xvfb x11-utils xdotool imagemagick fonts-dejavu-core libxext6 libxi6 \
    libxrender1 libxtst6 libfreetype6 libfontconfig1 procps python3 openbox && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
